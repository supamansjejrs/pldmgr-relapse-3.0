+      const size = meta ? meta.bytes : (source.bytes ? source.bytes.length : b64.length);
+      localStorage.setItem(entry.cacheKey, JSON.stringify({
+        b64: b64,
+        bytes: meta ? meta.bytes : size,
+        sha: meta ? meta.sha256 : null,
+        time: Date.now(),
+      }));
